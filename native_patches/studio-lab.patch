@@ -0,0 +1,60 @@
+import json
+import time
+import pytest
+from so101_lab import lab_lease
+
+
+def receipt(tmp_path, monkeypatch):
+    monkeypatch.setattr(lab_lease, 'folder', lambda:tmp_path)
+    value = {'contract_version':'homebrain.lab.v1','operation_id':'a'*32,'expected_generation':5,
+             'boot_id':lab_lease.BOOT_ID,'expires':time.monotonic()+.7,'revoked':False,'state':'intent'}
+    path = tmp_path/('dataset-ds_'+'b'*16+'.json')
+    path.write_text(json.dumps(value))
+    return path,value
+
+
+def test_delayed_project_worker_cannot_refresh_away_stop_fence(tmp_path, monkeypatch):
+    path,value = receipt(tmp_path, monkeypatch)
+    assert lab_lease.dataset_guard('ds_'+'b'*16,5) == 'a'*32
+    with pytest.raises(ValueError):
+        lab_lease.dataset_guard('ds_'+'b'*16,6)
+    value['revoked']=True
+    path.write_text(json.dumps(value))
+    with pytest.raises(ValueError):
+        lab_lease.dataset_guard('ds_'+'b'*16,5)
+
+
+def test_native_finalization_survives_browser_loss(tmp_path, monkeypatch):
+    path,value = receipt(tmp_path, monkeypatch)
+    (tmp_path/('operation-'+'a'*32+'.json')).write_text(json.dumps({**value,'expires':0}))
+    lab_lease.activate('a'*32)
+    lab_lease.finish()
+    assert not lab_lease.must_stop({'active':True,'state':'saving'}, {'active':False})
+    assert lab_lease.must_stop({'active':True,'state':'ready'}, {'active':False})
+    lab_lease.activate(None)
+
+
+def test_unmanaged_native_dataset_has_no_new_requirement(tmp_path, monkeypatch):
+    monkeypatch.setattr(lab_lease, 'folder', lambda:tmp_path)
+    assert lab_lease.dataset_guard('ds_'+'c'*16,9) is None
+    assert lab_lease.operation_guard(None,9) is None
+
+
+def test_previous_boot_and_implausible_future_lease_are_rejected(tmp_path, monkeypatch):
+    path, value = receipt(tmp_path, monkeypatch)
+    value['boot_id'] = 'previous-boot'
+    path.write_text(json.dumps(value))
+    with pytest.raises(ValueError):
+        lab_lease.dataset_guard('ds_'+'b'*16, 5)
+    value.update(boot_id=lab_lease.BOOT_ID, expires=time.monotonic()+1000)
+    path.write_text(json.dumps(value))
+    with pytest.raises(ValueError):
+        lab_lease.dataset_guard('ds_'+'b'*16, 5)
+
+
+def test_completed_homebrain_proof_requires_a_fresh_browser_intent(tmp_path, monkeypatch):
+    path, value = receipt(tmp_path, monkeypatch)
+    value['state'] = 'done'
+    path.write_text(json.dumps(value))
+    with pytest.raises(ValueError):
+        lab_lease.dataset_guard('ds_'+'b'*16, 5)
