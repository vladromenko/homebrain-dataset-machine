@@ -0,0 +1,35 @@
+"""Recover only previously authorized camera-only previews, never active recordings."""
+import asyncio
+import time
+from .hardware import CameraCapture
+
+
+def recover(preview, recording, teleoperation):
+    if recording.get('active') or recording.get('hardware_open') or teleoperation.get('active'):
+        return []
+    recovered = []
+    with preview.lock:
+        if preview.borrowers:
+            return []
+        for name, camera in list(preview.cameras.items()):
+            if camera.error:
+                camera.close()
+                replacement = CameraCapture(name, camera.device, camera.cfg)
+                preview.cameras[name] = replacement
+                try:
+                    replacement.start()
+                    replacement.info['recovery_generation'] = camera.info.get('recovery_generation', 0)+1
+                    replacement.info['recovery_policy'] = 'same persistent identity and native settings; no control resume'
+                    recovered.append(name)
+                except Exception as error:
+                    replacement.error = 'Camera reconnect pending: '+str(error)
+    return recovered
+
+
+async def monitor(preview, manager, teleoperation):
+    while True:
+        try:
+            await asyncio.to_thread(recover, preview, manager.status(), teleoperation.status())
+        except (OSError, RuntimeError, ValueError):
+            pass
+        await asyncio.sleep(2)
diff --git a/src/so101_lab/lab_finish.py b/src/so101_lab/lab_finish.py
new file mode 100644
index 0000000..87651df
--- /dev/null
+++ b/src/so101_lab/lab_finish.py
@@ -0,0 +1,26 @@
+"""Atomic native-session fence; the original native writer remains authoritative."""
+from fastapi import HTTPException
+from pydantic import BaseModel, ConfigDict, Field
+from . import lab_lease
+
+
+class Finish(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    dataset_id: str = Field(min_length=1,max_length=128)
+    session_id: str = Field(min_length=1,max_length=128)
+
+
+def install(app, status, command, lock):
+    @app.post('/api/lab/record/finish')
+    def finish(body: Finish):
+        with lock:
+            current = status()
+            if any(current.get(key)!=getattr(body,key) for key in ('dataset_id','session_id')):
+                raise HTTPException(409,'Native recording ownership changed; no other recording was ended')
+            if current.get('state')=='saving':
+                return current
+            if not current.get('active'):
+                raise HTTPException(409,'Selected native recording is no longer active; inspect its saved receipt')
+            result = command('end')
+            lab_lease.finish()
+            return result
diff --git a/src/so101_lab/lab_lease.py b/src/so101_lab/lab_lease.py
new file mode 100644
index 0000000..bd389d0
--- /dev/null
+++ b/src/so101_lab/lab_lease.py
@@ -0,0 +1,122 @@
+"""Native watchdog for Homebrain browser leases; other native callers keep their behavior."""
+import asyncio
+import json
+import os
+import re
+import time
+from pathlib import Path
+from fastapi import HTTPException
+from pydantic import BaseModel
+
+active = None
+last_error = None
+BOOT_ID = Path('/proc/sys/kernel/random/boot_id').read_text().strip()
+
+
+def folder():
+    default = Path.home()/'.local/share/homebrain-lab/handover'
+    return Path(os.environ.get('HOMEBRAIN_LAB_HANDOVER_DIR', default)).parent/'leases'
+
+
+def read(path):
+    value = json.loads(path.read_text())
+    if value.get('contract_version') != 'homebrain.lab.v1':
+        raise ValueError('Unsupported Homebrain browser lease')
+    return value
+
+
+def validate(value, generation):
+    remaining = value['expires']-time.monotonic()
+    if value.get('boot_id') != BOOT_ID or value['revoked'] or value.get('state') == 'done' or not 0 <= remaining <= 1:
+        raise ValueError('Homebrain browser lease expired. Focus the workspace and explicitly enable again.')
+    if value['expected_generation'] != generation:
+        raise ValueError('Homebrain Start was fenced by STOP. Reconcile the pending attempt.')
+    return value['operation_id']
+
+
+def dataset_guard(dataset, generation, managed=True):
+    if not managed or not re.fullmatch('ds_[a-f0-9]{16}', dataset):
+        return None
+    path = folder()/('dataset-'+dataset+'.json')
+    if not path.exists():
+        return None
+    value = read(path)
+    return validate(value, generation)
+
+
+def operation_guard(operation, generation):
+    if operation is None:
+        return None
+    if not re.fullmatch('[a-f0-9]{32}', operation):
+        raise ValueError('Invalid browser lease operation')
+    return validate(read(folder()/('operation-'+operation+'.json')), generation)
+
+
+def activate(operation):
+    global active
+    active = {'operation_id':operation, 'finalizing':None} if operation else None
+
+
+def finish():
+    if active:
+        active['finalizing'] = time.monotonic()
+
+
+def expired():
+    if not active:
+        return False
+    try:
+        value = read(folder()/('operation-'+active['operation_id']+'.json'))
+        return value.get('boot_id') != BOOT_ID or value['revoked'] or not 0 <= value['expires']-time.monotonic() <= 1
+    except (OSError, ValueError, KeyError):
+        return True
+
+
+def must_stop(recording, teleoperation):
+    if not active:
+        return False
+    if not recording.get('active') and not teleoperation.get('active'):
+        activate(None)
+        return False
+    if not expired():
+        return False
+    finalizing = active['finalizing']
+    if finalizing and recording.get('state') == 'saving':
+        return False
+    if finalizing and recording.get('state') == 'recording' and time.monotonic()-finalizing < 3:
+        return False
+    return True
+
+
+async def monitor(manager, teleoperation, stop):
+    global last_error
+    while True:
+        if must_stop(manager.status(), teleoperation.status()):
+            try:
+                await asyncio.to_thread(stop)
+                activate(None)
+                last_error = None
+            except Exception as error:
+                last_error = str(error)
+        await asyncio.sleep(.1)
+
+
+class StopOwned(BaseModel):
+    operation_id: str
+
+
+def install(app, manager_status, teleoperation_status, stop):
+    @app.get('/api/lab/lease')
+    def status():
+        return {'active':active, 'error':last_error, 'lease_seconds':.7, 'watchdog_seconds':.1,
+                'physical_stop_confirmed':False}
+
+    @app.post('/api/lab/lease/stop')
+    def stop_owned(body: StopOwned):
+        if not active or active['operation_id'] != body.operation_id:
+            return {'requested':False, 'reason':'This browser no longer owns native control'}
+        if active['finalizing'] and manager_status().get('state') in ('recording','saving'):
+            return {'requested':False, 'reason':'Native finalization continues; watchdog closes controls after saving'}
+        result = stop()
+        activate(None)
+        return {'requested':True, 'native':result}
diff --git a/src/so101_lab/lab_local.py b/src/so101_lab/lab_local.py
new file mode 100644
index 0000000..6d2257e
--- /dev/null
+++ b/src/so101_lab/lab_local.py
@@ -0,0 +1,18 @@
+"""New Homebrain transport stays loopback-only behind its authenticated app."""
+from starlette.responses import JSONResponse
+
+
+class LocalBoundary:
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope, receive, send):
+        client = scope.get('client') or ('',0)
+        internal = scope.get('path','').startswith('/api/lab/')
+        if internal and client[0] not in ('127.0.0.1','::1'):
+            if scope['type'] == 'websocket':
+                await send({'type':'websocket.close','code':4403})
+            else:
+                await JSONResponse({'detail':'Use the authenticated Homebrain app'},403)(scope,receive,send)
+        else:
+            await self.app(scope,receive,send)
diff --git a/src/so101_lab/lab_status.py b/src/so101_lab/lab_status.py
new file mode 100644
index 0000000..7abaaf8
--- /dev/null
+++ b/src/so101_lab/lab_status.py
@@ -0,0 +1,41 @@
+"""Cheap shared-stream status; dataset/job catalogs remain explicit reads."""
+import json
+from fastapi import HTTPException
+from . import jobs
+
+
+def install(app, manager, teleoperation, preview, generation):
+    from .lab_local import LocalBoundary
+    app.add_middleware(LocalBoundary)
+    @app.get('/api/lab/status')
+    def status():
+        return {'hardware_stop_generation':generation(), 'resources':{'inspection':'Run native preflight when preparing'},
+                'recording':manager().status() if manager() else {},
+                'teleoperation':teleoperation().status() if teleoperation() else {},
+                'preview':preview().status() if preview() else {},'jobs':live_jobs()}
+
+    @app.get('/api/lab/jobs/{identifier}')
+    def job(identifier: str):
+        try:
+            path=jobs.job_dir(identifier)
+            value=json.loads((path/'job.json').read_text())
+            if value['state'] in jobs.ACTIVE and (path/'pid').exists():
+                pid=int((path/'pid').read_text())
+                if not jobs.alive(identifier,pid):
+                    value.update(state='interrupted',error='Native worker stopped; artifacts retained')
+            return value
+        except (ValueError,OSError) as error:
+            raise HTTPException(404,str(error)) from error
+
+
+def live_jobs():
+    active=[]
+    for path in jobs.DIR.glob('*/pid'):
+        try:
+            identifier=path.parent.name
+            if jobs.alive(identifier,int(path.read_text())):
+                value=json.loads((path.parent/'job.json').read_text())
+                active.append({key:value.get(key) for key in ('id','kind','state','progress')})
+        except (OSError,ValueError):
+            pass
+    return active
