+import threading
+from types import SimpleNamespace
+from so101_lab.camera_recovery import recover
+
+
+def test_preview_reconnect_retains_identity_and_settings(monkeypatch):
+    old = SimpleNamespace(error='USB disconnected', device='/dev/persistent-camera', cfg={'fps':30}, info={}, close=lambda:None)
+    preview = SimpleNamespace(lock=threading.RLock(), borrowers=set(), cameras={'top':old})
+    class Replacement:
+        def __init__(self, name, device, cfg):
+            self.name,self.device,self.cfg,self.info=name,device,cfg,{}
+        def start(self):
+            self.error=None
+    monkeypatch.setattr('so101_lab.camera_recovery.CameraCapture', Replacement)
+    assert recover(preview, {'active':False}, {'active':False}) == ['top']
+    assert preview.cameras['top'].device == old.device
+    assert preview.cameras['top'].cfg == old.cfg
+    assert preview.cameras['top'].info['recovery_generation'] == 1
+
+
+def test_active_recording_or_borrower_is_never_reopened(monkeypatch):
+    preview = SimpleNamespace(lock=threading.RLock(), borrowers=set(), cameras={'top':SimpleNamespace(error='USB disconnected')})
+    monkeypatch.setattr('so101_lab.camera_recovery.CameraCapture', lambda *args:(_ for _ in ()).throw(AssertionError('No camera opens')))
+    assert recover(preview, {'active':True}, {}) == []
+    preview.borrowers.add('native-recorder')
+    assert recover(preview, {}, {}) == []
