new file mode 100644
index 0000000..76c0cf5
--- /dev/null
+++ b/tests/test_lab_finish.py
@@ -0,0 +1,28 @@
+"""A delayed Homebrain Finish cannot end a new native owner's recording."""
+import threading
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from so101_lab.lab_finish import install
+
+
+def test_finish_binding_is_checked_inside_native_lock():
+    lock = threading.RLock()
+    effects = []
+    current = {'active':True,'state':'recording','dataset_id':'new-dataset','session_id':'new-session'}
+    def status():
+        assert lock._is_owned()
+        return current
+    def command(action):
+        assert lock._is_owned()
+        effects.append(action)
+        return {'state':'saving'}
+    app = FastAPI()
+    install(app,status,command,lock)
+    with TestClient(app) as client:
+        stale = client.post('/api/lab/record/finish',json={'dataset_id':'old-dataset','session_id':'old-session'})
+        assert stale.status_code==409 and effects==[]
+        own = client.post('/api/lab/record/finish',json={'dataset_id':'new-dataset','session_id':'new-session'})
+        assert own.status_code==200 and effects==['end']
+        current['state']='saving'
+        repeated = client.post('/api/lab/record/finish',json={'dataset_id':'new-dataset','session_id':'new-session'})
+        assert repeated.status_code==200 and effects==['end']
