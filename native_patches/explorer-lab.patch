+"""Read-only native frames, with original source clock and conservative age."""
+import json
+import time
+from fastapi import HTTPException
+from fastapi.responses import Response
+
+
+def response(result, robot, elapsed_ms):
+    result.raise_for_status()
+    camera = json.loads(result.headers['X-Explorer-Camera'])
+    observation = json.loads(result.headers['X-Explorer-Observation'])
+    now, received = observation.get('monotonic_ns'), camera.get('received_ns')
+    if not isinstance(now,int) or not isinstance(received,int) or received>now:
+        raise ValueError('No verified native source timestamp')
+    age = (now-received)/1e6+elapsed_ms
+    if age>500 or camera.get('available') is False:
+        raise ValueError('Native '+robot+' camera is stale')
+    return Response(result.content,media_type='image/jpeg',headers={
+        'Cache-Control':'no-store','X-Frame-Age-Ms':str(age),'X-Frame-Robot':robot,
+        'X-Frame-Sequence':str(camera.get('sequence','unknown')),
+        'X-Frame-Clock':camera.get('source_clock','native_agent_monotonic'),
+        'X-Frame-Metadata':json.dumps(camera)})
+
+
+def install(app):
+    @app.get('/api/lab/tank/frame.jpg')
+    def tank():
+        from .tank import client
+        try:
+            started=time.monotonic()
+            with client() as connection:
+                result=connection.get('/frame.jpg',timeout=1)
+            return response(result,'tank',(time.monotonic()-started)*1000)
+        except Exception as error:
+            raise HTTPException(503,'No fresh authorized Tank frame: '+str(error)) from error
+
+    @app.get('/api/lab/rosmaster/frame.jpg')
+    async def rosmaster():
+        from .rosmaster_monitor import fetch
+        try:
+            started=time.monotonic()
+            result=await fetch('/frame.jpg')
+            return response(result,'rosmaster',(time.monotonic()-started)*1000)
+        except Exception as error:
+            raise HTTPException(503,'No fresh authorized ROSMASTER frame: '+str(error)) from error
