--- /dev/null
+++ b/explorer4/lab_local.py
@@ -0,0 +1,18 @@
+"""New Homebrain transport stays loopback-only behind its authenticated app."""
+from starlette.responses import JSONResponse
+
+
+class LocalBoundary:
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope, receive, send):
+        client = scope.get('client') or ('',0)
+        internal = scope.get('path','').startswith('/api/lab/')
+        if internal and client[0] not in ('127.0.0.1','::1'):
+            if scope['type'] == 'websocket':
+                await send({'type':'websocket.close','code':4403})
+            else:
+                await JSONResponse({'detail':'Use the authenticated Homebrain app'},403)(scope,receive,send)
+        else:
+            await self.app(scope,receive,send)
