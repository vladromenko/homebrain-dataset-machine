@@ -0,0 +1,188 @@
+import asyncio
+import json
+import threading
+import time
+from types import SimpleNamespace
+import pytest
+from fastapi import WebSocketDisconnect
+from explorer4.lab_api import Bridge, Start, public_sample
+
+
+class Control:
+    def __init__(self):
+        self.owner = None
+        self.generation = 0
+        self.robot = 'tank'
+        self.session = 'native-session'
+        self.last_stop_reason = None
+        self.lock = threading.RLock()
+        self.cleared = False
+
+    def stop(self, reason):
+        self.generation += 1
+        self.owner = None
+        self.last_stop_reason = reason
+
+    def clear_base_inputs(self):
+        self.cleared = True
+
+    def heartbeat(self, owner):
+        self.last_heartbeat = owner
+
+
+class Session:
+    def __init__(self, control):
+        self.control = control
+        self.thread = None
+        self.latest = None
+        self.phase = 'idle'
+        self.record_requested = False
+        self.frame_count = 0
+        self.last_episode_id = 'old-episode'
+        self.error = None
+        self.started = False
+
+    def start(self, owner, profile, scene, **kwargs):
+        self.started = True
+        self.control.owner = owner
+
+    def finish(self, outcome, reason):
+        self.outcome = outcome
+        self.control.stop(reason)
+
+
+def test_stale_generation_and_missing_focused_browser_reject_start():
+    control = Control()
+    session = Session(control)
+    bridge = Bridge(control, session)
+    body = Start(owner='focused-browser', profile='tank_dock', scene='fixture', expected_generation=0)
+    with pytest.raises(PermissionError):
+        asyncio.run(bridge.start(body))
+    bridge.connections[body.owner] = time.monotonic()
+    control.stop('independent STOP')
+    with pytest.raises(ValueError):
+        asyncio.run(bridge.start(body))
+    assert not session.started
+
+
+def test_stop_during_manual_handover_fences_record_start():
+    control = Control()
+    session = Session(control)
+    control.owner = 'focused-browser'
+    class Thread:
+        def is_alive(self):
+            return True
+        def join(self, timeout):
+            control.stop('STOP during handover')
+    session.thread = Thread()
+    bridge = Bridge(control, session)
+    bridge.connections[control.owner] = time.monotonic()
+    body = Start(owner=control.owner, profile='tank_dock', scene='fixture', expected_generation=0)
+    with pytest.raises(PermissionError):
+        asyncio.run(bridge.start(body))
+    assert not session.started
+
+
+def test_public_sample_never_serializes_raw_pixels():
+    sample = {'images': {'front': {'image': object(), 'sequence': 7, 'reused': True}}, 'state_valid': False}
+    public = public_sample(sample)
+    assert public['images']['front'] == {'sequence':7, 'reused':True}
+    assert json.loads(json.dumps(public))['state_valid'] is False
+
+
+def test_independent_keys_keep_separate_native_sources():
+    control = Control()
+    calls = []
+    control.base_key = lambda *args: calls.append(args)
+    bridge = Bridge(control, Session(control))
+    bridge.connections['focused-browser'] = time.monotonic()
+    async def packets():
+        await bridge.packet('focused-browser', {'kind':'key','key':'up','pressed':True,'source':'KeyW'})
+        await bridge.packet('focused-browser', {'kind':'key','key':'left','pressed':True,'source':'KeyA'})
+    asyncio.run(packets())
+    assert [call[-1] for call in calls] == ['homebrain:KeyW','homebrain:KeyA']
+
+
+def test_chat_focus_clears_inputs_without_finishing_writer():
+    control = Control()
+    control.owner = 'focused-browser'
+    session = Session(control)
+    bridge = Bridge(control, session)
+    asyncio.run(bridge.packet(control.owner, {'kind':'clear_inputs'}))
+    assert control.cleared and not hasattr(session, 'outcome')
+
+
+def test_frame_age_is_source_clock_plus_round_trip():
+    import httpx
+    from explorer4.lab_observation import response
+    packet = httpx.Response(200,content=b'jpeg',request=httpx.Request('GET','http://fixture/frame'),headers={
+        'X-Explorer-Camera':json.dumps({'received_ns':1_000_000,'sequence':7}),
+        'X-Explorer-Observation':json.dumps({'monotonic_ns':2_000_000})})
+    accepted = response(packet,'tank',10)
+    assert accepted.headers['X-Frame-Age-Ms'] == '11.0'
+    with pytest.raises(ValueError):
+        response(packet,'tank',600)
+
+
+def test_ros_generation_and_input_fence_reject_delayed_enable_and_start():
+    from explorer4.lab_ros_guard import generation
+    control = SimpleNamespace(generation=3,lock=threading.RLock(),inputs={'owner':(time.monotonic(),{})},owner=None,lease=None)
+    packet = {'homebrain_request':'a'*32,'expected_generation':2}
+    with pytest.raises(PermissionError):
+        generation(control,'owner','enable',packet)
+    packet['expected_generation'] = 3
+    assert generation(control,'owner','enable',packet) == 3
+    with pytest.raises(PermissionError):
+        generation(control,'owner','record_start',packet)
+    control.owner,control.lease='owner','native-lease'
+    assert generation(control,'owner','record_start',packet) == 3
+    control.inputs.clear()
+    with pytest.raises(PermissionError):
+        generation(control,'owner','record_start',packet)
+
+
+def test_new_transport_denies_lan_http_and_websocket_before_native_effect():
+    from explorer4.lab_local import LocalBoundary
+    calls=[]
+    async def native(scope, receive, send):
+        calls.append('native')
+    async def receive():
+        return {'type':'http.request','body':b''}
+    async def exercise():
+        packets=[]
+        async def send(packet):
+            packets.append(packet)
+        guard=LocalBoundary(native)
+        await guard({'type':'http','path':'/api/lab/record/start','client':('192.0.2.2',123)},receive,send)
+        await guard({'type':'websocket','path':'/api/lab/control','client':('192.0.2.2',123)},receive,send)
+        await guard({'type':'http','path':'/api/lab/status','client':('127.0.0.1',123)},receive,send)
+        return packets
+    packets=asyncio.run(exercise())
+    assert packets[0]['status']==403 and packets[-1]['code']==4403
+    assert calls==['native']
+
+
+def test_assisted_exclusion_cannot_modify_another_native_collection(tmp_path,monkeypatch):
+    import sqlite3
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    from explorer4 import lab_collection
+    path=tmp_path/'catalog.sqlite'
+    def connect():
+        db=sqlite3.connect(path)
+        db.row_factory=sqlite3.Row
+        return db
+    with connect() as db:
+        db.execute('CREATE TABLE collection_series(id TEXT,operator TEXT,description TEXT)')
+        db.executemany('INSERT INTO collection_series VALUES(?,?,?)',[
+            ('ours','Homebrain Lab','Homebrain Lab development / placement'),('foreign','other','Other collection')])
+    calls=[]
+    monkeypatch.setattr(lab_collection.catalog,'connect',connect)
+    monkeypatch.setattr(lab_collection,'quality',lambda identifier:{'attempt':{'series':'ours'}})
+    monkeypatch.setattr(lab_collection.collection,'exclude',lambda identifier:calls.append(identifier))
+    app=FastAPI()
+    lab_collection.install_exclusion(app)
+    client=TestClient(app)
+    assert client.post('/api/lab/quality/episode/exclude',json={'collection_id':'foreign'}).status_code==403
+    assert client.post('/api/lab/quality/episode/exclude',json={'collection_id':'ours'}).json()['raw_retained']
+    assert calls==['episode']
