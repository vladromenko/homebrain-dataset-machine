index 0000000..66c9142
--- /dev/null
+++ b/explorer4/lab_api.py
@@ -0,0 +1,217 @@
+"""Additive Homebrain boundary over the existing application singletons."""
+import asyncio
+import time
+import uuid
+from fastapi import HTTPException, WebSocket, WebSocketDisconnect
+from pydantic import BaseModel, ConfigDict, Field
+from . import catalog, collection
+
+
+class Start(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    owner: str = Field(min_length=10, max_length=100)
+    profile: str = Field(pattern=r'^tank_dock(_rgbd_lidar)?$')
+    scene: str = Field(min_length=1, max_length=200)
+    record: bool = True
+    expected_generation: int
+    category: str = Field(default='demonstration', pattern=r'^(demonstration|correction)$')
+    collection_id: str | None = None
+
+
+class Finish(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    owner: str
+    outcome: str = Field(pattern=r'^(success|failure|aborted)$')
+
+
+class Bridge:
+    def __init__(self, control, session):
+        self.control, self.session = control, session
+        self.connections = {}
+
+    def status(self):
+        sample = self.session.latest or {}
+        stamp = sample.get('observation_timestamp_ns')
+        return {'contract_version': 'homebrain.lab.v1', 'generation': self.control.generation,
+                'robot': self.control.robot, 'owner': self.control.owner,
+                'session_id': self.control.session, 'phase': self.session.phase,
+                'thread_active': bool(self.session.thread and self.session.thread.is_alive()),
+                'recording': self.session.record_requested, 'frames': self.session.frame_count,
+                'last_episode_id': self.session.last_episode_id, 'error': self.session.error,
+                'sample_age_ms': (time.monotonic_ns()-stamp)/1e6 if stamp else None,
+                'sample': public_sample(sample), 'stop_reason': self.control.last_stop_reason,
+                'physical_stop_confirmed': False}
+
+    def require(self, owner):
+        stamp = self.connections.get(owner, 0)
+        if time.monotonic()-stamp > .7:
+            raise PermissionError('A focused live browser control connection is required')
+
+    async def start(self, body):
+        self.require(body.owner)
+        generation = body.expected_generation
+        if generation != self.control.generation:
+            raise ValueError('STOP generation changed; refresh before explicit Start')
+        if self.session.thread and self.session.thread.is_alive():
+            if self.control.owner != body.owner or self.session.record_requested:
+                raise PermissionError('The native session is already owned or recording')
+            self.session.finish('aborted', 'Homebrain manual-to-record handover')
+            generation += 1
+            await asyncio.to_thread(self.session.thread.join, 8)
+        self.require(body.owner)
+        with self.control.lock:
+            if generation != self.control.generation:
+                raise PermissionError('Start cancelled by STOP during handover')
+            if self.control.robot != 'tank':
+                self.control.select('tank')
+            self.session.start(body.owner, body.profile, body.scene, record=body.record,
+                               category=body.category, collection_id=body.collection_id)
+        return self.status()
+
+    def finish(self, body):
+        self.require(body.owner)
+        if self.control.owner != body.owner:
+            raise PermissionError('Only the current native owner may finish')
+        self.session.finish(body.outcome, 'Homebrain finish requested')
+        return self.status()
+
+    async def control_socket(self, websocket):
+        await websocket.accept()
+        owner = 'homebrain-' + uuid.uuid4().hex
+        self.connections[owner] = time.monotonic()
+        try:
+            await websocket.send_json({'owner': owner, 'status': self.status()})
+            while True:
+                packet = await asyncio.wait_for(websocket.receive_json(), timeout=1)
+                await self.packet(owner, packet)
+                await websocket.send_json({'owner': owner, 'status': self.status()})
+        except (WebSocketDisconnect, TimeoutError):
+            pass
+        finally:
+            self.connections.pop(owner, None)
+            if self.control.owner == owner:
+                self.control.clear_base_inputs()
+                self.session.finish('aborted', 'Homebrain browser lease lost; partial evidence retained')
+
+    async def packet(self, owner, packet):
+        if packet.get('kind') == 'heartbeat':
+            self.connections[owner] = time.monotonic()
+            self.control.heartbeat(owner)
+        elif packet.get('kind') == 'key':
+            self.require(owner)
+            self.control.base_key(owner, packet.get('key'), packet.get('pressed') is True,
+                                  'homebrain:'+str(packet.get('source', packet.get('key')))[:50])
+        elif packet.get('kind') == 'clear_inputs':
+            if self.control.owner == owner:
+                self.control.clear_base_inputs()
+        elif packet.get('kind') == 'clear':
+            if self.control.owner == owner:
+                self.control.clear_base_inputs()
+                self.session.finish('aborted', 'Homebrain focus/target cleared')
+        else:
+            raise ValueError('Unsupported control packet')
+
+
+def public_sample(sample):
+    keys = {'observation_timestamp_ns', 'camera_missing', 'observation.state', 'motion_sensors', 'state_kind', 'state_valid', 'measured_response_kind', 'battery_voltage', 'battery_source', 'imu_raw', 'imu_agent_received_ns'}
+    visible = {key: value.tolist() if hasattr(value, 'tolist') else value for key, value in sample.items() if key in keys}
+    visible['images'] = {role: {key: value for key, value in image.items() if key != 'image'}
+                         for role, image in sample.get('images', {}).items()}
+    return visible
+
+
+def install(app, control, session):
+    bridge = Bridge(control, session)
+
+    @app.get('/api/lab/status')
+    def status():
+        return bridge.status()
+
+    @app.post('/api/lab/record/start')
+    async def start(body: Start):
+        try:
+            return await bridge.start(body)
+        except (ValueError, PermissionError, RuntimeError) as error:
+            raise HTTPException(409, str(error)) from error
+
+    @app.post('/api/lab/record/finish')
+    def finish(body: Finish):
+        try:
+            return bridge.finish(body)
+        except (ValueError, PermissionError, RuntimeError) as error:
+            raise HTTPException(409, str(error)) from error
+
+    @app.post('/api/lab/stop')
+    def stop():
+        control.clear_base_inputs()
+        control.stop('Homebrain independent STOP')
+        return bridge.status()
+
+    @app.websocket('/api/lab/control')
+    async def control_socket(websocket: WebSocket):
+        await bridge.control_socket(websocket)
+
+    from .lab_observation import install as install_observation
+    install_observation(app)
+    from .lab_collection import install as install_collection
+    install_collection(app)
+    install_readback(app)
+    install_simulation(app)
+    return bridge
+
+
+def install_readback(app):
+    @app.get('/api/lab/capabilities')
+    def capabilities():
+        from .profiles import PROFILES, SIM_PROFILES
+        return {'profiles': PROFILES, 'simulation_profiles': SIM_PROFILES,
+                'native_owner': 'Explorer', 'catalog': '/api/lab/recordings'}
+
+    @app.get('/api/lab/rosmaster/operations/{identifier}')
+    def operation(identifier: str):
+        from .rosmaster_console import LAB_ACKS
+        return LAB_ACKS.get(identifier, {'operation_id':identifier,'status':'pending'})
+
+    @app.get('/api/lab/recordings')
+    def recordings():
+        return {'episodes': catalog.rows('episodes')[:100], 'collections': collection.overview()}
+
+    @app.get('/api/lab/jobs')
+    def jobs():
+        return {'jobs': catalog.rows('jobs')[:100]}
+
+
+def simulation_service(kind):
+    from .sim_service import service as individual
+    from .fleet_service import service as shared
+    if kind not in {'individual', 'shared'}:
+        raise ValueError('Unknown simulation namespace')
+    return individual if kind == 'individual' else shared
+
+
+class SimulationAction(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    command: str
+    arguments: dict = {}
+
+
+def install_simulation(app):
+    @app.get('/api/lab/simulation/{kind}')
+    def status(kind: str):
+        try:
+            return simulation_service(kind).request()
+        except Exception as error:
+            raise HTTPException(503, str(error)) from error
+
+    @app.post('/api/lab/simulation/{kind}')
+    def action(kind: str, body: SimulationAction):
+        allowed = {'start', 'close', 'claim', 'release', 'pause', 'profile', 'reset', 'heartbeat', 'target', 'demonstrate'}
+        allowed |= {'record', 'finish'} if kind == 'individual' else {'select', 'scene', 'snapshot', 'restore', 'allocation_check'}
+        if body.command not in allowed:
+            raise HTTPException(422, 'Unsupported native simulation operation')
+        service = simulation_service(kind)
+        try:
+            from .lab_simulation import execute
+            return execute(kind, service, body.command, body.arguments)
+        except Exception as error:
+            raise HTTPException(409, str(error)) from error
