@@ -0,0 +1,42 @@
+"""Respect existing compute reservations around Homebrain-started simulators."""
+from contextlib import ExitStack
+from .resources import ResourceLease, ExistingTrainingLease
+
+_reservations = {}
+
+
+def execute(kind, service, command, arguments):
+    if command == 'start':
+        return start(kind, service)
+    if command == 'close':
+        return close(kind, service, arguments.get('operator'))
+    return service.request(command, **arguments)
+
+
+def start(kind, service):
+    try:
+        return service.request()
+    except (OSError, RuntimeError):
+        reservation = ExitStack()
+        try:
+            reservation.enter_context(ResourceLease('compute'))
+            reservation.enter_context(ExistingTrainingLease())
+            result = service.start()
+            _reservations[kind] = reservation
+            return result
+        except Exception:
+            reservation.close()
+            raise
+
+
+def close(kind, service, owner):
+    state = service.request()
+    if state.get('recording') or state.get('finalizing'):
+        raise ValueError('Finish the native simulated writer before closing')
+    if state.get('owner') not in (None, owner):
+        raise PermissionError('Another operator owns this simulator')
+    if kind not in _reservations or service.process is None:
+        raise PermissionError('This adapter did not start the simulator; retain its original owner')
+    service.shutdown()
+    _reservations.pop(kind).close()
+    return {'closed': True, 'domain': 'simulation'}
