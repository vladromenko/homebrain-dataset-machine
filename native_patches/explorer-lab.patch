+"""Narrow access to native collection setup and completed quality receipts."""
+import json
+import re
+import threading
+from fastapi import HTTPException
+from pydantic import BaseModel, ConfigDict, Field
+from . import catalog, collection
+
+_setup_lock = threading.RLock()
+
+
+class Setup(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    task: str
+    profile: str
+    binding: str = Field(pattern=r'^[a-z0-9_-]{4,100}$')
+    instruction: str = Field(min_length=1, max_length=200)
+
+
+def prepare(body):
+    marker = 'Homebrain Lab development / '+body.binding
+    with _setup_lock:
+        series = collection.series(body.task)
+        matches = [row for row in series if row['description'] == marker and row['operator'] == 'Homebrain Lab']
+        if len(matches) > 1:
+            raise ValueError('Ambiguous native station binding; inspect its existing series')
+        if matches:
+            return matches[0]
+        profile = series[0]['profile'] if series else body.profile
+        return collection.create_series(body.task, profile, 'Homebrain Lab', marker, instruction=body.instruction)
+
+
+def quality(identifier):
+    if not re.fullmatch(r'[A-Za-z0-9_-]{1,120}', identifier):
+        raise ValueError('Invalid native episode identity')
+    collection.initialize()
+    with catalog.connect() as db:
+        row = db.execute('SELECT * FROM collection_attempts WHERE episode=?', (identifier,)).fetchone()
+    if row is None:
+        return {'episode_id': identifier, 'state': 'unmanaged', 'quality': None}
+    result = dict(row)
+    result['quality'] = json.loads(result['quality']) if result.get('quality') else None
+    return {'episode_id': identifier, 'state': result['phase'], 'attempt': result, 'quality': result['quality']}
+
+
+def install(app):
+    @app.get('/api/lab/rosmaster/status')
+    def rosmaster_status():
+        from .rosmaster_console import operator, recorder
+        return {'recording': {**recorder.status(), 'thread_active': recorder.active()},
+                'owner': operator.owner, 'armed': bool(operator.lease), 'generation': operator.generation}
+
+    @app.post('/api/lab/collections/prepare')
+    def setup(body: Setup):
+        try:
+            return prepare(body)
+        except ValueError as error:
+            raise HTTPException(409, str(error)) from error
+
+    @app.get('/api/lab/quality/{identifier}')
+    def read_quality(identifier: str):
+        try:
+            return quality(identifier)
+        except ValueError as error:
+            raise HTTPException(422, str(error)) from error
