@@ -0,0 +1,17 @@
+"""Fence Homebrain WS actions to the actual browser input and captured STOP generation."""
+import time
+
+
+def generation(operator, owner, action, value):
+    if 'homebrain_request' not in value:
+        return operator.generation
+    expected = value.get('expected_generation')
+    with operator.lock:
+        if type(expected) is not int or expected != operator.generation:
+            raise PermissionError('Homebrain action fenced by STOP; refresh and explicitly enable again')
+        stamp, _ = operator.inputs.get(owner, (0, None))
+        if time.monotonic()-stamp > .3:
+            raise PermissionError('Focused native browser input is required')
+        if action in ('record_start', 'mirror_on', 'preset') and (operator.owner != owner or not operator.lease):
+            raise PermissionError('Explicitly enable this native controller before the requested action')
+    return expected
